# Copy these into Vercel (Project Settings > Environment Variables) and redeploy.
# Find both in Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: Google's own sign-in button, so the Google pop-up names your site instead of the Supabase address.
# Use the same Client ID you pasted into Supabase (Google Cloud > Credentials). It is public, not a secret.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
